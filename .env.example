# Configure secrets in Vercel > Project > Settings > Environment Variables.
# Never put keys in public files or chat. FAQ mode works without any key.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Default OpenRouter model. Use gpt-4o-mini if AI_PROVIDER=openai.
AI_MODEL=openai/gpt-4o-mini
# Optional alternative provider:
OPENAI_API_KEY=
# Optional HTTPS endpoint to receive customer/owner inquiries after consent.
# Without this endpoint the form provides copy-and-send-via-Zalo handoff.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Encrypted listing data/session signing key (separate from admin login password); use the provided secure setup file.
# Do not use a different value without re-encrypting the private dataset.
ADMIN_SECRET=

# Membership, persistent leads/posts and private file storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Telegram notices to the owner's selected chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Canonical URL for new property social previews.
SITE_URL=https://nguonchothue.vn

# Owner-only Telegram source inbox; separate from notification bot.
TELEGRAM_SOURCE_BOT_TOKEN=
TELEGRAM_SOURCE_OWNER_ID=
# Auto-publish incurs paid OpenAI text/image API usage. Run SQL 004 then 005 first.
TELEGRAM_AUTO_PUBLISH=false
TELEGRAM_AUTO_DAILY_LIMIT=20
SOURCE_AI_MODEL=gpt-4o-mini
SOURCE_IMAGE_MODEL=gpt-image-1
# Random >=32 characters for the daily Vercel recovery job.
CRON_SECRET=

# provided: parse text by rules and use attached Telegram photos, no paid AI API.
# ai: OpenAI parsing + generated illustration (paid, default for existing setups).
TELEGRAM_SOURCE_MODE=provided

# Private customer watchlist: run database/007_customer_watch.sql first.
# Create a NEW bot, separate from source inbox and site notification bots.
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_OWNER_ID=
# Optional paid image OCR; disabled by default. No key is needed for text/DOCX/XLSX/text-PDF.
CUSTOMER_IMAGE_OCR_ENABLED=false
CUSTOMER_OCR_MODEL=gpt-4o-mini
# Optional private one-way website -> Google Sheet. Use a dedicated restricted spreadsheet.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
CUSTOMER_GOOGLE_SHEET_ID=
CUSTOMER_SHEETS_AUTO_SYNC=true

# Google Docs/Sheets command portal: run database/008_google_commands.sql after 007.
# Reuses GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON; enable BOTH Google Docs API and Sheets API.
# Share every input/output file with the account's client_email as Editor.
# Saved daily commands use the existing CRON_SECRET / source-recovery schedule.

# Apps Script -> saved Docs source command. Unique random secret, at least 32 characters.
# Keep server-side; same value in Apps Script property WEBSITE_GOOGLE_KEY.
GOOGLE_DOCS_AUTOMATION_SECRET=

# Paste-source editor: text rewrite reuses AI_PROVIDER / AI_MODEL and its key.
# Image generation uses OPENAI_API_KEY + SOURCE_IMAGE_MODEL (even with OpenRouter text).
# Without a text key, the editor still fills an explicitly labelled rules-based draft.

# Three additional outbound-only bots. Use 3 NEW tokens; keep existing bots unchanged.
TELEGRAM_SCANNED_PROPERTY_BOT_TOKEN=
TELEGRAM_SCANNED_PROPERTY_CHAT_ID=
TELEGRAM_SCANNED_CUSTOMER_BOT_TOKEN=
TELEGRAM_SCANNED_CUSTOMER_CHAT_ID=
TELEGRAM_MATCH_BOT_TOKEN=
TELEGRAM_MATCH_CHAT_ID=
# Opt in only after test messages reach the intended private administrator chats.
MATCH_BOTS_ENABLED=0

# Read-only Apify token: Actor Read/List runs and Storages Read. Never public.
APIFY_TOKEN=
